# Firmware files (drop into firmware/input/ manually)
firmware/input/*.exe
firmware/input/*.bin
firmware/input/*.rom
firmware/input/*.cap

# Extracted output (generated, not tracked)
firmware/extracted/pfs/*/
firmware/extracted/uefi/*/
firmware/extracted/pe_images/*/

# Ghidra project databases (binary db files)
ghidra_projects/*/
!ghidra_projects/.gitkeep
# Track deep_re text analysis outputs
!ghidra_projects/*/deep_re/
!ghidra_projects/*/deep_re/*.txt

# Tools (installed separately, not committed)
/tools/

# Python cache
__pycache__/
*.pyc
